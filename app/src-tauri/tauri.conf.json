{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ocr4code",
  "version": "0.1.6",
  "identifier": "com.ocr4code.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ocr4code",
        "width": 920,
        "height": 620,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Screenshot OCR for code and terminals",
    "longDescription": "Turn screenshots of code, terminals and stack traces into text on the clipboard. Runs offline against a local vision model; layout is reconstructed from pixels.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
