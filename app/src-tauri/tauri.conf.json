{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sofer",
  "version": "1.1.0",
  "identifier": "com.sofer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sofer",
        "width": 1120,
        "height": 740,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Screenshot OCR for code and terminals",
    "longDescription": "Turn screenshots of code, terminals and stack traces into text on the clipboard. Runs offline against a local vision model; layout is reconstructed from pixels.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hfwang0318/sofer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwRDMyMjIxRDhDRDhBNDMKUldSRGlzM1lJU0xUVUdTVWZaa3FESjE4Rk5jMitZQWt5TUF3Si9LVUVZUzF6d1pwdXcwdG13YkoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
